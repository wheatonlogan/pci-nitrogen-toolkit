  "fonts": {
    "_note": "TWO STACKS, and they are not interchangeable. Print/deck uses the licensed PCI faces; web uses Roboto, which is what pcigases.com runs on. Each print weight is addressed by its FULL FACE NAME with bold OFF \u2014 this matches PCI's own decks.",
    "print": {
      "_note": "Typeface names and flags match PCI's own PowerPoint decks (checked against 'PCI mining application 2025.pptx'): each weight is addressed by its full name with bold off. The sales team needs Neufile Grotesk and Mr Eaves XL Modern installed (they are desktop-licensed company fonts).",
      "display": {
        "face": "Neufile Grotesk Light",
        "bold": false,
        "file": "NeufileGrotesk-Light.ttf"
      },
      "body": {
        "face": "Neufile Grotesk Regular",
        "bold": false,
        "file": "NeufileGrotesk-Regular.ttf"
      },
      "medium": {
        "face": "Neufile Grotesk Medium",
        "bold": false,
        "file": "NeufileGrotesk-Medium.ttf"
      },
      "semibold": {
        "face": "Neufile Grotesk SemiBold",
        "bold": false,
        "file": "NeufileGrotesk-SemiBold.ttf"
      },
      "bold": {
        "face": "Neufile Grotesk Bold",
        "bold": false,
        "file": "NeufileGrotesk-Bold.ttf"
      },
      "eyebrow": {
        "face": "MrEavesXLModOT-Book",
        "bold": false,
        "file": "MrEavesXLModOT-Book.ttf",
        "caps": true,
        "tracking": 300
      },
      "highlight": {
        "face": "MrEavesXLModOT-Bold",
        "bold": false,
        "file": "MrEavesXLModOT-Bold.ttf"
      }
    },
    "web": {
      "_note": "Elementor kit 9 global typography, read live from the site.",
      "family": "Roboto",
      "google_fonts": "https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap",
      "display": {
        "face": "Roboto",
        "weight": 300,
        "elementor_global": "primary"
      },
      "body": {
        "face": "Roboto",
        "weight": 400,
        "elementor_global": "text"
      },
      "medium": {
        "face": "Roboto",
        "weight": 500,
        "elementor_global": "secondary"
      },
      "label": {
        "face": "Roboto",
        "weight": 500,
        "elementor_global": "accent"
      },
      "trap": "The WP theme self-hosts Roboto with each weight as a SEPARATE FAMILY (robotolight, robotothin, robotoregular) so font-weight does nothing there. Never replicate that."
    }
  },
