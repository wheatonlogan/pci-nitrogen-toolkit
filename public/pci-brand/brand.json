  "geometry": {
    "wedge_ratio": 0.5615,
    "wedge_ratio_note": "run/rise of the PCI Line. The collateral generator states dx/dy ~0.57 from the logo triangle; the Elementor block library uses 0.5615. They agree within 3%. Use 0.5615 everywhere. Never a percentage clip-path, never Elementor's Shape Divider.",
    "radius_default_px": 0,
    "radius_ui_px": 3,
    "radius_bluebox_px": 10,
    "slide_emu": {
      "width": 24382413,
      "height": 13716000,
      "inches": [
        26.67,
        15.0
      ],
      "ratio": "16:9",
      "note": "PCI's deck template is exactly 2x standard widescreen. Match it or the masters, logo placement and type scale all come out wrong."
    },
    "sell_sheet_in": {
      "trim": [
        8.5,
        11.0
      ],
      "bleed": 0.125,
      "document": [
        8.75,
        11.25
      ]
    },
    "logo_min_height_in": 0.3
  },
  "rules": {
    "body_text_print": "black",
    "body_text_screen": "dark_grey",
    "accent_max_area_pct": 6,
    "min_contrast_text": 4.5,
    "min_contrast_large": 3.0,
    "pale_accent_on_light_resolves_to": "cobalt",
    "headline_case": "Upper-and-lower; never ALL CAPS (eyebrow labels excepted)",
    "print_min_dpi": 250,
    "print_target_dpi": 300,
    "no_two_tone_wedge_banners": true,
    "slide_footer": "PCI Gases Confidential & Proprietary",
    "tagline": "Reshape your tomorrow",
    "chart_series_cap_default": 4,
    "chart_series_cap_extended": 5,
    "chart_series_cap_all_pairs": 3,
    "web_body_ink": "dark_grey",
    "print_body_ink": "black",
    "print_min_type_pt": 7,
    "print_min_body_pt": 8,
    "copy_fidelity": "Copy is verbatim from source. If it does not fit, CUT it \u2014 never shrink. On a deck, overflow goes to the speaker notes. Log every cut.",
    "scope_class_web": "pci-app",
    "scope_class_elementor": "pci-ip"
  },
